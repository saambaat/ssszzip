---
import LanguageSwitcher from '../components/LanguageSwitcher.tsx';
import MobileNav from '../components/MobileNav.tsx';
import Search from '../components/Search.tsx';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { asLang, localePath, stripLocale, useTranslations } from '../i18n/utils';
import { monthKey, monthName } from '../lib/months';
import type { Pairing } from '../lib/moment-schema';
import { allPairingIds, resolvePairing } from '../lib/pairings';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  activePairing?: Pairing;
  months?: string[];
  lang?: Lang;
  robots?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, activePairing, months = [], robots } = Astro.props;
const lang = Astro.props.lang ?? asLang(Astro.currentLocale);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;
const path = stripLocale(Astro.url.pathname);
const pairings = allPairingIds.map((id) => ({ id, name: resolvePairing(id, lang).name }));
const site = Astro.site ?? Astro.url;
const canonical = new URL(localePath(lang, path), site).href;
const description = Astro.props.description ?? t('site.description');
const ogImage = new URL(asset(Astro.props.ogImage ?? 'og.png'), site).href;
const feedUrl = new URL(asset(lang === defaultLang ? 'rss.xml' : `${lang}/rss.xml`), site).href;
const jsonLd = Astro.props.schema
  ? JSON.stringify(Astro.props.schema).replace(/</g, '\\u003c')
  : undefined;
const ogLocales: Record<Lang, string> = { en: 'en_US', ko: 'ko_KR', zh: 'zh_CN' };
const localeUrls = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((code) => [code, localePath(code, path)]),
) as Record<Lang, string>;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={asset('favicon.ico')} sizes="48x48" />
    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={t('site.title')} href={feedUrl} />
    <meta property="og:type" content={Astro.props.type ?? 'website'} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      (Object.keys(languages) as Lang[])
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(localePath(code, path), site).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <script is:inline>
      var theme = 'system';
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') theme = stored;
      } catch (e) {}
      var dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="antialiased">
    <header class="sticky top-0 z-30 border-b bg-background/80 backdrop-blur">
      <div class="flex items-center gap-3 px-4 py-3 sm:px-6">
        <MobileNav pairings={pairings} activePairing={activePairing} lang={lang} client:load />
        <a
          href={localePath(lang, '/')}
          class="shrink-0 text-sm font-semibold transition-colors hover:text-muted-foreground"
        >
          {t('site.title')}
        </a>
        <div class="ml-auto flex min-w-0 flex-1 items-center justify-end gap-2 lg:max-w-md">
          <Search lang={lang} client:load />
          <LanguageSwitcher lang={lang} urls={localeUrls} client:load />
          <ThemeToggle lang={lang} client:load />
        </div>
      </div>
    </header>
    <div
      class={`grid gap-6 px-4 py-6 sm:px-6 lg:gap-8 ${
        months.length > 0
          ? 'lg:grid-cols-[12rem_minmax(0,1fr)_10rem]'
          : 'lg:grid-cols-[12rem_minmax(0,1fr)]'
      }`}
    >
      <Sidebar pairings={pairings} activePairing={activePairing} lang={lang} />
      <main class="min-w-0">
        <slot />
      </main>
      {
        months.length > 0 && (
          <aside class="sticky top-20 hidden self-start lg:block" aria-label={t('nav.months')}>
            <p class="mb-2 pl-3 text-xs font-medium text-muted-foreground">{t('nav.months')}</p>
            <ul class="flex flex-col gap-0.5 border-l">
              {months.map((month) => (
                <li>
                  <a
                    href={`#${monthKey(month)}`}
                    class="-ml-px block border-l border-transparent px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
                  >
                    {monthName(month, lang)}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
    <script>
      const loadVideo = (video: HTMLVideoElement) => {
        const poster = video.dataset.poster;
        if (poster) {
          video.poster = poster;
          delete video.dataset.poster;
        }

        const src = video.dataset.src;
        if (src) {
          video.src = src;
          delete video.dataset.src;
        }
      };

      const videos = document.querySelectorAll<HTMLVideoElement>('[data-preview]');

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              loadVideo(entry.target as HTMLVideoElement);
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '300px' },
      );

      videos.forEach((video) => {
        observer.observe(video);

        video.addEventListener('mouseenter', () => {
          loadVideo(video);
          video.play().catch(() => {});
        });

        video.addEventListener('mouseleave', () => {
          video.pause();
        });
      });
    </script>
  </body>
</html>
