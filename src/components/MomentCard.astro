---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { thumbUrl, videoUrl } from '../lib/imgur';
import { headingFor, momentHref, subFor } from '../lib/moment-display';
import type { Moment } from '../lib/moment-schema';
import { resolvePairing } from '../lib/pairings';
import CardFrame from './CardFrame.astro';

interface Props {
  moment: Moment;
  lang: Lang;
  showPairing?: boolean;
}

const { moment, lang, showPairing = true } = Astro.props;
const t = useTranslations(lang);
const heading = headingFor(moment, lang);
const sub = subFor(moment, lang);
const href = momentHref(moment, lang);
const pairing = resolvePairing(moment.pairing, lang);
const badges = [...(showPairing ? [pairing.name] : []), t(`momentType.${moment.momentType}`)];
---

<CardFrame href={href} data-date={moment.date} badges={badges}>
  <video
    slot="media"
    data-src={videoUrl(moment.id)}
    data-poster={thumbUrl(moment.id)}
    data-preview
    muted
    loop
    playsinline
    preload="none"
    aria-label={heading}
    class="cursor-pointer block h-full w-full object-cover"></video>
  <h2 class="line-clamp-2 text-base leading-normal font-medium">{heading}</h2>
  {sub && <p class="mt-1 text-sm text-muted-foreground">{sub}</p>}
</CardFrame>
