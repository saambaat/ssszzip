---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { posterUrl } from '../lib/imgur';
import { headingFor, momentHref } from '../lib/moment-display';
import { moments } from '../lib/moments';
import { monthKey, monthName } from '../lib/months';
import MomentCard from './MomentCard.astro';

interface Props {
  lang: Lang;
  year: string;
}

const { lang, year } = Astro.props;
const t = useTranslations(lang);

const yearMoments = moments.filter((moment) => moment.date.startsWith(year));
const months = [...new Set(yearMoments.map((moment) => moment.date.slice(0, 7)))];
const grouped = months.map((month) => ({
  month,
  items: yearMoments.filter((moment) => moment.date.startsWith(month)),
}));

const site = Astro.site ?? Astro.url;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${year} · ${t('site.title')}`,
    description: `${year} · ${t('site.description')}`,
    url: new URL(localePath(lang, `/${year}`), site).href,
    inLanguage: lang,
    hasPart: yearMoments.map((moment) => ({
      '@type': 'VideoObject',
      name: headingFor(moment, lang),
      url: new URL(momentHref(moment, lang), site).href,
      thumbnailUrl: posterUrl(moment.id),
      uploadDate: `${moment.date}T00:00:00Z`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('nav.home'),
        item: new URL(localePath(lang, '/'), site).href,
      },
      { '@type': 'ListItem', position: 2, name: year },
    ],
  },
];
---

<BaseLayout
  title={`${year} · ${t('site.title')}`}
  description={`${year} · ${t('site.description')}`}
  lang={lang}
  months={months}
  schema={schema}
>
  <h1 class="text-lg font-semibold">{year}</h1>
  <div class="mt-4 space-y-6">
    {
      grouped.map(({ month, items }) => (
        <section class="scroll-mt-24" id={monthKey(month)}>
          <h2 class="mb-3 text-sm font-medium text-muted-foreground">{monthName(month, lang)}</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] gap-5">
            {items.map((moment) => <MomentCard moment={moment} lang={lang} />)}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
