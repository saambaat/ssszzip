---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { largeUrl, thumbUrl } from '../lib/imgur';
import { moments } from '../lib/moments';
import type { Pairing } from '../lib/moment-schema';
import { ogPairingPath } from '../lib/og';
import { accentGradient, resolvePairing } from '../lib/pairings';
import MomentCard from './MomentCard.astro';

interface Props {
  pairing: Pairing;
  lang: Lang;
}

const { pairing: pairingId, lang } = Astro.props;
const t = useTranslations(lang);

const pairing = resolvePairing(pairingId, lang);
const pairingMoments = moments.filter((moment) => moment.pairing === pairingId);
const years = [...new Set(pairingMoments.map((moment) => moment.date.slice(0, 4)))];
const groupedYears = years.map((year) => ({
  year,
  items: pairingMoments.filter((moment) => moment.date.startsWith(year)),
}));
const accentCard = accentGradient(pairing.accentColors);
const filterClass =
  'rounded-full border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground aria-pressed:border-foreground aria-pressed:bg-sidebar-accent aria-pressed:font-medium aria-pressed:text-foreground';

const site = Astro.site ?? Astro.url;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${pairing.name} · ${t('site.title')}`,
    description: pairing.description,
    url: new URL(localePath(lang, `/${pairingId}`), site).href,
    inLanguage: lang,
    about: pairing.members.map((name) => ({ '@type': 'Person', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('nav.home'),
        item: new URL(localePath(lang, '/'), site).href,
      },
      { '@type': 'ListItem', position: 2, name: pairing.name },
    ],
  },
];
---

<BaseLayout
  title={`${pairing.name} · ${t('site.title')}`}
  description={pairing.description ?? `${pairing.name} · ${t('site.description')}`}
  lang={lang}
  activePairing={pairingId}
  ogImage={ogPairingPath(pairingId, lang)}
  schema={schema}
>
  <div class="overflow-hidden rounded-xl border bg-black">
    <img
      src={largeUrl(pairing.banner)}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="h-44 w-full object-cover sm:h-72"
    />
  </div>
  <div class="mt-3 grid gap-5 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <div class="relative self-start rounded-xl border bg-card p-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 rounded-[inherit]"
        style={`background: ${accentCard}`}
      >
      </div>
      <img
        src={thumbUrl(pairing.cover)}
        alt=""
        decoding="async"
        class="relative mx-auto -mt-16 size-28 rounded-2xl border-4 border-card bg-black object-cover shadow-md sm:-mt-24 sm:size-36"
      />
      <div class="relative mt-3 text-center">
        <h1 class="text-lg font-semibold">{pairing.name}</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {t('pairing.members')}: {pairing.members.join(' · ')}
        </p>
      </div>
      {
        pairing.description && (
          <p class="relative mt-3 text-sm">{pairing.description}</p>
        )
      }
    </div>
    <div class="space-y-6">
      {
        years.length > 1 && (
          <div
            class="flex flex-wrap items-center gap-2"
            role="group"
            aria-label={t('pairing.filters')}
            data-year-filters
          >
            <button type="button" data-filter="all" aria-pressed="true" class={filterClass}>
              {t('pairing.filterAll')}
            </button>
            {years.map((year) => (
              <button type="button" data-filter={year} aria-pressed="false" class={filterClass}>
                {year}
              </button>
            ))}
          </div>
        )
      }
      {
        groupedYears.map(({ year, items }) => (
          <section
            id={year}
            data-year={year}
            class="scroll-mt-24 rounded-xl transition-colors target:bg-sidebar-accent/50"
          >
            <h2 class="mb-3 text-sm font-medium text-muted-foreground">{year}</h2>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,14rem),1fr))] gap-5">
              {items.map((moment) => (
                <MomentCard moment={moment} lang={lang} showPairing={false} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const filterGroup = document.querySelector<HTMLElement>('[data-year-filters]');

  if (filterGroup) {
    const buttons = [...filterGroup.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-year]')];
    const values = new Set(buttons.map((button) => button.dataset.filter));

    const apply = (value: string, updateUrl = true) => {
      const active = value && values.has(value) ? value : 'all';
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === active));
      }
      for (const section of sections) {
        section.hidden = active !== 'all' && section.dataset.year !== active;
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (active === 'all') {
          url.searchParams.delete('year');
        } else {
          url.searchParams.set('year', active);
        }
        history.replaceState(null, '', url);
      }
    };

    filterGroup.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
      if (button?.dataset.filter) apply(button.dataset.filter);
    });

    const initial = new URLSearchParams(window.location.search).get('year');
    if (initial) apply(initial, false);
  }
</script>
