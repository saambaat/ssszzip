---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPageResults from './SearchPageResults.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('search.placeholder')} · ${t('site.title')}`}
  description={`${t('search.placeholder')} · ${t('site.description')}`}
  lang={lang}
  robots="noindex"
>
  <h1 class="text-lg font-semibold">{t('search.placeholder')}</h1>
  <SearchPageResults lang={lang} client:load />
</BaseLayout>
